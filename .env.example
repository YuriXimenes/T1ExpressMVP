# Convenção para a futura camada de backend (auth, banco de dados, etc.)
# A maioria dessas variáveis ainda não é usada nesta etapa (dados mock).

# URL pública da API (exposta ao client — nunca coloque segredos aqui)
NEXT_PUBLIC_API_URL=

# Segredo de assinatura de sessão/JWT (apenas server-side)
AUTH_SECRET=

# String de conexão do banco de dados (apenas server-side)
DATABASE_URL=

# Supabase — o schema já existe no banco (ver supabase/migrations/), mas o
# app ainda não está ligado nele (continua rodando em cima de dados mock).
# Preencha estes valores em .env.local (nunca aqui, nunca commitado).

# URL do projeto Supabase (exposta ao client — não é segredo)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável do Supabase (exposta ao client — não é segredo)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta do Supabase — acesso total, nunca expor ao client (apenas server-side)
SUPABASE_SECRET_KEY=
