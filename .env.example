# Convenção para a futura camada de backend (auth, banco de dados, etc.)
# A maioria dessas variáveis ainda não é usada nesta etapa (dados mock).

# URL pública da API (exposta ao client — nunca coloque segredos aqui)
NEXT_PUBLIC_API_URL=

# Segredo de assinatura de sessão/JWT (apenas server-side)
AUTH_SECRET=

# String de conexão do banco de dados (apenas server-side)
DATABASE_URL=
